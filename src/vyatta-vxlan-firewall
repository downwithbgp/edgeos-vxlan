#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
#
# vyatta-vxlan-firewall - native EdgeOS firewall attachment lifecycle helper
# for VXLAN interfaces.
#
# The vendor engine owns firewall policy and chain construction.  This helper
# only manages the per-interface dispatch in the Vyatta hook chains:
#   - validate an attachment before any mutation,
#   - apply the configured attachments through /usr/sbin/ubnt-fw,
#   - verify that the dispatch is effective (not just that a command returned 0),
#   - capture and restore the pre-commit state for rollback,
#   - fail closed when a required attachment cannot be established or restored.
#
# Enforcement-reducing transitions are quiesced: when a change removes an
# existing dispatch from an interface that is administratively up, the helper
# takes the interface down before the mutation and leaves it down.  The caller
# activates the interface only after its own gate passes.  A single
# replacement or insertion is a single atomic `iptables --replace/--insert`
# inside the vendor engine (verified against the installed binary) and is not
# quiesced.
#
# `--capture` exits 3 when the live dispatch is ambiguous (two or more jumps
# for the interface) and 4 when the filter table cannot be read, so the caller
# can distinguish an untrustworthy firewall state from a generic failure.
#
# Paths used by the test-suite are overridable through environment variables.

set -eEu -o pipefail

if [ "$(id -g -n)" != "vyattacfg" ]; then
    echo "This script must be executed from vyatta configuration system."
    exit 1
fi

VYATTA_SBINDIR=${vyatta_sbindir:-/opt/vyatta/sbin}
VYATTA_API="${VYATTA_SBINDIR}/my_cli_shell_api"
UBNT_FW=${vxlan_bin_ubnt_fw:-/usr/sbin/ubnt-fw}
IPTABLES=${vxlan_bin_iptables:-/sbin/iptables}
IP6TABLES=${vxlan_bin_ip6tables:-/sbin/ip6tables}
VXLAN_SYSFS_ROOT=${vxlan_sysfs_root:-/sys}

die() {
    echo "ERROR: $*" >&2
    return 1
}

usage() {
    cat >&2 <<'EOF'
usage: vyatta-vxlan-firewall --validate <iface> <in|out|local> <name|ipv6-name> <ruleset>
       vyatta-vxlan-firewall --capture <iface>
       vyatta-vxlan-firewall --apply <iface>          (pre-change state on stdin; empty = capture)
       vyatta-vxlan-firewall --restore <iface>        (captured lines on stdin)
       vyatta-vxlan-firewall --verify-all <iface>
       vyatta-vxlan-firewall --remove-all <iface>
       vyatta-vxlan-firewall --status <iface>
EOF
}

# ------------------------------------------------------------------ config API

# The vendor API exits 1 both for "node absent" and for an internal failure; a
# failure writes a diagnostic to stderr while a negative lookup is silent.
# Reading an API failure as "absent" would turn a broken configuration read
# into a removed firewall dispatch, so a diagnostic aborts the operation.
api_exists() {
    local err rc=0
    err=$("$VYATTA_API" exists "$@" 2>&1 >/dev/null) || rc=$?
    if [ "$rc" -eq 0 ]; then
        return 0
    fi
    if [ -n "$err" ]; then
        echo "ERROR: configuration API failure: $err" >&2
        exit 1
    fi
    return 1
}

node_exists_working() {
    api_exists interfaces vxlan "$IFACE" "$@"
}

node_value() {
    local value err
    err=${TMPDIR:-/tmp}/vxlan-fw-api.$$
    if value=$("$VYATTA_API" returnValue interfaces vxlan "$IFACE" "$@" 2>"$err"); then
        rm -f "$err"
        printf '%s' "$value"
        return 0
    fi
    if [ -s "$err" ]; then
        echo "ERROR: configuration API failure: $(cat "$err")" >&2
    fi
    rm -f "$err"
    return 1
}

parent_exists() {
    api_exists interfaces vxlan "$IFACE"
}

ruleset_exists() {
    api_exists firewall "$FAMILY" "$NAME"
}

# --------------------------------------------------------------- validation

check_iface() {
    case "$IFACE" in
        vxlan[0-9]*) ;;
        *) die "interface '$IFACE' is not a VXLAN interface name (vxlanN)" ;;
    esac
    case "${IFACE#vxlan}" in
        '' | *[!0-9]*) die "interface '$IFACE' is not a VXLAN interface name (vxlanN)" ;;
    esac
}

check_direction() {
    case "$DIRECTION" in
        in | out | local) ;;
        *) die "invalid firewall direction '$DIRECTION' (expected in, out or local)" ;;
    esac
}

check_family() {
    case "$FAMILY" in
        name | ipv6-name) ;;
        *) die "invalid firewall family '$FAMILY' (expected name or ipv6-name)" ;;
    esac
}

check_name() {
    case "$NAME" in
        '' | *[!A-Za-z0-9_.:-]*)
            die "invalid firewall ruleset name '$NAME'"
            return 1
            ;;
    esac
    case "$NAME" in
        [A-Za-z0-9_]*) ;;
        *) die "invalid firewall ruleset name '$NAME'" ;;
    esac
    if [ "${#NAME}" -gt 28 ]; then
        die "firewall ruleset name '$NAME' is longer than 28 characters"
        return 1
    fi
}

check_native_name() {
    if [ ! -x "$UBNT_FW" ]; then
        die "native firewall engine $UBNT_FW is not available"
        return 1
    fi
    if ! "$UBNT_FW" validate-fw-name "$NAME" >/dev/null 2>&1; then
        die "native firewall engine rejected ruleset name '$NAME'"
        return 1
    fi
}

validate_attachment() {
    check_iface
    check_direction
    check_family
    check_name

    # When the interface itself is being deleted, the attachment is going away
    # with it; there is nothing useful to validate.
    if ! parent_exists; then
        return 0
    fi

    if node_exists_working bridge-group bridge; then
        die "firewall attachments are not supported on VXLAN bridge port $IFACE"
        return 1
    fi

    check_native_name
    if ! ruleset_exists; then
        die "firewall ruleset '$NAME' is not configured under firewall $FAMILY"
        return 1
    fi
    return 0
}

# --------------------------------------------------------------- iptables

iptables_cmd() {
    case "$FAMILY" in
        name) printf '%s' "$IPTABLES" ;;
        ipv6-name) printf '%s' "$IP6TABLES" ;;
    esac
}

hook_name() {
    case "$DIRECTION" in
        in) printf '%s' "VYATTA_FW_IN_HOOK" ;;
        out) printf '%s' "VYATTA_FW_OUT_HOOK" ;;
        local) printf '%s' "VYATTA_FW_LOCAL_HOOK" ;;
    esac
}

hook_flag() {
    case "$DIRECTION" in
        out) printf '%s' "-o" ;;
        *) printf '%s' "-i" ;;
    esac
}

run_iptables() {
    local cmd
    cmd=$(iptables_cmd)
    sudo "$cmd" -t filter "$@"
}

read_table_rules() {
    run_iptables -S
}

# Print the configured jump target(s) for IFACE/DIRECTION/FAMILY from a saved
# `iptables -S` listing supplied on stdin.  More than one line is an error.
find_targets_from_rules() {
    local hook flag
    hook=$(hook_name)
    flag=$(hook_flag)
    awk -v hook="$hook" -v flag="$flag" -v iface="$IFACE" '
        $1 == "-A" && $2 == hook {
            has_if = 0
            target = ""
            for (i = 3; i <= NF; i++) {
                if ($i == "!") { i++; continue }
                if ($i == flag && $(i + 1) == iface) { has_if = 1 }
                if ($i == "-j" && $(i + 1) != "") { target = $(i + 1) }
            }
            if (has_if && target != "") { print target }
        }
    '
}

find_target() {
    local rules
    if ! rules=$(read_table_rules 2>/dev/null); then
        die "cannot read the filter table with $(iptables_cmd)"
        return 1
    fi
    printf '%s\n' "$rules" | find_targets_from_rules
}

# ------------------------------------------------------------- admin state

# Sets IFACE_ADMIN to up, down, absent or unknown.  A netdevice that does not
# exist is distinct from one whose flags cannot be read: only the former is a
# safe "cannot carry traffic" answer.
read_admin_state() {
    local raw digits
    if [ ! -e "${VXLAN_SYSFS_ROOT}/class/net/${IFACE}" ]; then
        IFACE_ADMIN=absent
        return 0
    fi
    if ! raw=$(cat "${VXLAN_SYSFS_ROOT}/class/net/${IFACE}/flags" 2>/dev/null); then
        IFACE_ADMIN=unknown
        return 0
    fi
    case "$raw" in
        0[xX]*)
            digits=${raw#0[xX]}
            case "$digits" in
                '' | *[!0-9a-fA-F]*)
                    IFACE_ADMIN=unknown
                    return 0
                    ;;
            esac
            if (((0x$digits & 0x1) != 0)); then
                IFACE_ADMIN=up
            else
                IFACE_ADMIN=down
            fi
            ;;
        '' | *[!0-9]*) IFACE_ADMIN=unknown ;;
        *)
            if (((10#$raw & 0x1) != 0)); then
                IFACE_ADMIN=up
            else
                IFACE_ADMIN=down
            fi
            ;;
    esac
}

# Stop the interface from carrying traffic and report exactly what was
# verified.  An unknown administrative state is treated as "may be up" and a
# down is attempted; a down is never claimed when it was not confirmed.
stop_interface() {
    local reason=$1
    read_admin_state
    case "$IFACE_ADMIN" in
        absent)
            echo "ERROR: $reason; $IFACE does not exist." >&2
            return 0
            ;;
        down)
            echo "ERROR: $reason; $IFACE is administratively down." >&2
            return 0
            ;;
    esac
    if ! sudo ip link set dev "$IFACE" down; then
        echo "ERROR: $reason; $IFACE could not be taken down and may still carry traffic." >&2
        return 0
    fi
    read_admin_state
    case "$IFACE_ADMIN" in
        down) echo "ERROR: $reason; $IFACE left administratively down." >&2 ;;
        *) echo "ERROR: $reason; $IFACE was taken down but its administrative state could not be confirmed." >&2 ;;
    esac
    return 0
}

# Bring the interface back up and report the outcome.
resume_interface() {
    local reason=$1
    if ! sudo ip link set dev "$IFACE" up; then
        echo "ERROR: $reason; $IFACE could not be brought back up." >&2
        return 1
    fi
    read_admin_state
    case "$IFACE_ADMIN" in
        up) echo "INFO: $reason; $IFACE restored to the up state." >&2 ;;
        *) echo "WARNING: $reason; $IFACE was brought up but its administrative state could not be confirmed." >&2 ;;
    esac
    return 0
}

fail_closed_new_attachment() {
    stop_interface "requested firewall attachment could not be established"
}

# After a failed apply, restore the pre-commit state.  If that fails, the live
# policy is uncertain: take the interface down rather than leave it operational
# with an unknown firewall state.  A failed request for a *new* attachment
# leaves the interface down even after a successful restore; otherwise the
# previous, verified policy is restored before the interface is brought back up
# (the migration handover relies on the same ordering).
recover_apply_failure() {
    local new_attachment=$1 old_state=$2
    MUTATED=0
    if ! restore_state <<<"$old_state"; then
        echo "ERROR: could not restore the pre-commit firewall state for $IFACE." >&2
        stop_interface "could not restore the pre-commit firewall state"
        return 0
    fi
    if [ "$new_attachment" -eq 1 ]; then
        fail_closed_new_attachment
    elif [ "${QUIESCED:-0}" -eq 1 ]; then
        resume_interface "the pre-commit firewall state was restored"
    fi
}

verify_present() {
    local cmd hook flag
    cmd=$(iptables_cmd)
    hook=$(hook_name)
    flag=$(hook_flag)
    if ! sudo "$cmd" -t filter -C "$hook" "$flag" "$IFACE" -j "$NAME" >/dev/null 2>&1; then
        die "firewall attachment is not effective: $IFACE $DIRECTION $FAMILY -> $NAME"
        return 1
    fi
}

# A configured ruleset must have a non-empty chain.  An empty user chain
# returns to the hook chain without a verdict, which is not the enforcement
# the operator configured.
chain_is_nonempty() {
    local cmd rules
    cmd=$(iptables_cmd)
    if ! rules=$(sudo "$cmd" -t filter -S "$NAME" 2>/dev/null); then
        die "firewall ruleset chain '$NAME' is missing"
        return 1
    fi
    if ! printf '%s\n' "$rules" | grep -q '^-A '; then
        die "firewall ruleset chain '$NAME' is empty"
        return 1
    fi
    return 0
}

# The vendor appends the configured default-action rule as the last rule of the
# ruleset chain.  A chain that does not end in a verdict falls through to the
# hook and then to the base chain, so the configured default action would not
# be effective.
chain_has_terminal_default() {
    local cmd rules target
    cmd=$(iptables_cmd)
    if ! rules=$(sudo "$cmd" -t filter -S "$NAME" 2>/dev/null); then
        die "firewall ruleset chain '$NAME' is missing"
        return 1
    fi
    target=$(printf '%s\n' "$rules" | awk '
        $1 == "-A" {
            target = ""
            for (i = 1; i <= NF; i++) {
                if ($i == "-j" && $(i + 1) != "") { target = $(i + 1) }
            }
            seen = 1
        }
        END {
            if (!seen) { exit 1 }
            print target
        }
    ') || {
        die "firewall ruleset chain '$NAME' is empty"
        return 1
    }
    case "$target" in
        ACCEPT | DROP | REJECT | RETURN) return 0 ;;
    esac
    die "firewall ruleset chain '$NAME' does not end in a terminal default action"
    return 1
}

base_chain() {
    case "$DIRECTION" in
        local) printf '%s' "INPUT" ;;
        *) printf '%s' "FORWARD" ;;
    esac
}

# The hook chain must actually be reached from the base chain.  A missing jump,
# or an earlier rule that matches this interface (or everything) and carries a
# terminal verdict, makes the per-interface dispatch inert.  This is a bounded
# reachability check; it does not evaluate nested user chains.
verify_hook_reachable() {
    local rules base hook flag
    base=$(base_chain)
    hook=$(hook_name)
    flag=$(hook_flag)
    if ! rules=$(read_table_rules 2>/dev/null); then
        die "cannot read the filter table with $(iptables_cmd)"
        return 1
    fi
    if ! printf '%s\n' "$rules" | awk -v base="$base" -v hook="$hook" \
        -v flag="$flag" -v iface="$IFACE" '
        $1 == "-A" && $2 == base {
            if (found) { next }
            exact = (NF == 4 && $3 == "-j" && $4 == hook)
            has_if = 0
            wildcard = 0
            terminal = 0
            target = ""
            for (i = 3; i <= NF; i++) {
                if ($i == "!") { i++; continue }
                if ($i == flag) {
                    v = $(i + 1)
                    if (v == iface) { has_if = 1 }
                    if (v ~ /\+$/) {
                        p = substr(v, 1, length(v) - 1)
                        if (substr(iface, 1, length(p)) == p) { wildcard = 1 }
                    }
                }
                if ($i == "-j" && $(i + 1) != "") { target = $(i + 1) }
            }
            if (target ~ /^(ACCEPT|DROP|REJECT|RETURN)$/) { terminal = 1 }
            if (exact) { found = 1; next }
            if (terminal && (has_if || wildcard || NF == 4)) { shadowed = 1 }
        }
        END {
            if (!found) {
                print "hook " hook " is not reached from " base > "/dev/stderr"
                exit 1
            }
            if (shadowed) {
                print "hook " hook " is shadowed by a preceding rule in " base > "/dev/stderr"
                exit 2
            }
            exit 0
        }
    '; then
        die "firewall hook reachability verification failed for $IFACE $DIRECTION ($base)"
        return 1
    fi
    return 0
}

# Verify the *whole* dispatch, not just that one matching rule exists:
#   - exactly one exact rule for this interface/direction/target;
#   - no malformed or stale rule for the same interface;
#   - no non-interface rule before the dispatch that could shadow it.
# The native ubnt-fw rule is exactly `-A <hook> <flag> <iface> -j <target>`.
verify_dispatch_exact() {
    local rules hook flag
    hook=$(hook_name)
    flag=$(hook_flag)
    if ! rules=$(read_table_rules 2>/dev/null); then
        die "cannot read the filter table with $(iptables_cmd)"
        return 1
    fi
    if ! printf '%s\n' "$rules" | awk -v hook="$hook" -v flag="$flag" -v iface="$IFACE" -v target="$NAME" '
        {
            if ($1 != "-A" || $2 != hook) { next }
            exact = (NF == 6 && $3 == flag && $4 == iface && $5 == "-j" && $6 == target)
            simple = (NF == 6 && ($3 == "-i" || $3 == "-o") && $5 == "-j" && $4 !~ /[+*!]/)
            matches_if = 0
            for (i = 3; i <= NF; i++) {
                if ($i == flag && $(i + 1) == iface) { matches_if = 1 }
            }
            if (exact) { found++; next }
            if (matches_if) { malformed = 1 }
            if (!found && !simple) { shadowed = 1 }
        }
        END {
            if (found == 0) { print "missing" > "/dev/stderr"; exit 1 }
            if (found > 1) { print "duplicate" > "/dev/stderr"; exit 2 }
            if (malformed) { print "malformed or stale" > "/dev/stderr"; exit 3 }
            if (shadowed) { print "shadowed by a preceding rule" > "/dev/stderr"; exit 4 }
            exit 0
        }
    '; then
        die "firewall dispatch verification failed for $IFACE $DIRECTION $FAMILY -> $NAME"
        return 1
    fi
    return 0
}

target_or_absent() {
    local hits
    if ! hits=$(find_target); then
        return 1
    fi
    case "$hits" in
        '') printf '%s' "-" ;;
        *$'\n'*)
            die "ambiguous firewall dispatch for $IFACE in $DIRECTION ($FAMILY)"
            return 1
            ;;
        *) printf '%s' "$hits" ;;
    esac
}

# --------------------------------------------------------------- state

capture_state() {
    local family dir rules hits target
    for family in name ipv6-name; do
        FAMILY=$family
        if ! rules=$(read_table_rules 2>/dev/null); then
            echo "ERROR: cannot capture firewall state: $(iptables_cmd) -S failed" >&2
            return 4
        fi
        for dir in in out local; do
            DIRECTION=$dir
            if ! hits=$(printf '%s\n' "$rules" | find_targets_from_rules); then
                return 1
            fi
            case "$hits" in
                '') target="-" ;;
                *$'\n'*)
                    echo "ERROR: ambiguous firewall dispatch for $IFACE in $DIRECTION ($FAMILY)" >&2
                    return 3
                    ;;
                *) target=$hits ;;
            esac
            if [ "$family" = "name" ]; then
                printf 'v4 %s %s\n' "$dir" "$target"
            else
                printf 'v6 %s %s\n' "$dir" "$target"
            fi
        done
    done
}

desired_target() {
    local dir=$1 family=$2 value
    if node_exists_working firewall "$dir" "$family"; then
        if ! value=$(node_value firewall "$dir" "$family"); then
            die "cannot read configured $family attachment for $IFACE ($dir)"
            return 1
        fi
        printf '%s' "$value"
        return 0
    fi
    printf '%s' "-"
}

validate_state() {
    local family dir target seen_v4_in=0 seen_v4_out=0 seen_v4_local=0
    local seen_v6_in=0 seen_v6_out=0 seen_v6_local=0
    while read -r family dir target; do
        case "$family" in \#* | '') continue ;; esac
        case "$family $dir" in
            'v4 in') seen_v4_in=1 ;;
            'v4 out') seen_v4_out=1 ;;
            'v4 local') seen_v4_local=1 ;;
            'v6 in') seen_v6_in=1 ;;
            'v6 out') seen_v6_out=1 ;;
            'v6 local') seen_v6_local=1 ;;
            *)
                die "malformed firewall state line: $family $dir $target"
                return 1
                ;;
        esac
        case "$target" in
            -) ;;
            [A-Za-z0-9_]*)
                case "$target" in
                    *[!A-Za-z0-9_.:-]*)
                        die "malformed firewall state target '$target'"
                        return 1
                        ;;
                esac
                if [ "${#target}" -gt 28 ]; then
                    die "malformed firewall state target '$target'"
                    return 1
                fi
                ;;
            *) die "malformed firewall state target '$target'" ;;
        esac
    done
    if [ "$seen_v4_in$seen_v4_out$seen_v4_local$seen_v6_in$seen_v6_out$seen_v6_local" != "111111" ]; then
        die "incomplete firewall state for $IFACE"
        return 1
    fi
    return 0
}

restore_state() {
    local family dir target current cmd hook flag hits state
    state=$(cat)
    validate_state <<<"$state" || return 1
    while read -r family dir target; do
        case "$family" in \#* | '') continue ;; esac
        case "$family" in v4) FAMILY=name ;; v6) FAMILY=ipv6-name ;; esac
        DIRECTION=$dir
        cmd=$(iptables_cmd)
        hook=$(hook_name)
        flag=$(hook_flag)

        if ! current=$(find_target); then
            return 1
        fi
        case "$current" in
            '') current="-" ;;
            *$'\n'*)
                die "ambiguous firewall dispatch while restoring $IFACE $dir ($FAMILY)"
                return 1
                ;;
        esac
        if [ "$target" != "-" ]; then
            NAME=$target
            if ! chain_is_nonempty; then
                return 1
            fi
            if ! chain_has_terminal_default; then
                return 1
            fi
        fi
        if [ "$current" = "$target" ]; then
            if [ "$target" != "-" ]; then
                NAME=$target
                if ! verify_dispatch_exact; then
                    return 1
                fi
                if ! verify_hook_reachable; then
                    return 1
                fi
            fi
            continue
        fi

        if [ "$target" = "-" ]; then
            if [ "$current" != "-" ]; then
                if ! "$UBNT_FW" update-interface delete "$IFACE" "$DIRECTION" "$current" "$FAMILY"; then
                    die "cannot remove firewall dispatch $current while restoring $IFACE $dir ($FAMILY)"
                    return 1
                fi
            fi
        elif "$UBNT_FW" update-interface update "$IFACE" "$DIRECTION" "$target" "$FAMILY" >/dev/null 2>&1; then
            :
        elif sudo "$cmd" -t filter -S "$target" >/dev/null 2>&1; then
            # The old ruleset is no longer in the configuration but its chain
            # still exists.  Reinsert the jump directly, as a bounded recovery.
            # Insert the restored jump first, then remove the superseded rule:
            # the interface always has a policy during the swap.
            if ! sudo "$cmd" -t filter -I "$hook" 1 "$flag" "$IFACE" -j "$target"; then
                die "cannot restore firewall dispatch $target for $IFACE $dir ($FAMILY)"
                return 1
            fi
            if [ "$current" != "-" ]; then
                if ! sudo "$cmd" -t filter -D "$hook" "$flag" "$IFACE" -j "$current" >/dev/null 2>&1; then
                    die "cannot remove the superseded firewall dispatch $current after restoring $target for $IFACE $dir ($FAMILY)"
                    return 1
                fi
            fi
        else
            die "cannot restore firewall dispatch $target for $IFACE $dir ($FAMILY): ruleset is unavailable"
            return 1
        fi

        if ! hits=$(find_target); then
            return 1
        fi
        case "$hits" in '') hits="-" ;; esac
        if [ "$hits" != "$target" ]; then
            die "firewall dispatch restoration did not converge for $IFACE $dir ($FAMILY)"
            return 1
        fi
        if [ "$target" != "-" ]; then
            NAME=$target
            if ! verify_dispatch_exact; then
                return 1
            fi
            if ! verify_hook_reachable; then
                return 1
            fi
        fi
    done <<<"$state"
    return 0
}

# --------------------------------------------------------------- operations

# Plan the desired attachment set from the working configuration.  The output
# has the same canonical six-line shape as a captured state, so the two can be
# compared and validated with the same code.
desired_state() {
    local family dir value
    for family in name ipv6-name; do
        for dir in in out local; do
            if node_exists_working firewall "$dir" "$family"; then
                if ! value=$(node_value firewall "$dir" "$family"); then
                    die "cannot read configured $family attachment for $IFACE ($dir)"
                    return 1
                fi
            else
                value="-"
            fi
            case "$family" in
                name) printf 'v4 %s %s\n' "$dir" "$value" ;;
                *) printf 'v6 %s %s\n' "$dir" "$value" ;;
            esac
        done
    done
}

apply_state() {
    local old_state desired old_family old_dir old_target hits line
    local family dir new_target changes=0 new_attachment=0 removal=0 i
    local old_lines=() desired_lines=()

    old_state=$(cat)
    if [ -z "$old_state" ]; then
        if ! old_state=$(capture_state); then
            die "cannot capture the pre-change firewall state for $IFACE"
            return 1
        fi
    fi
    validate_state <<<"$old_state" || return 1
    APPLY_OLD_STATE=$old_state

    # The configuration API must be available: reading a failure as "no
    # attachment configured" would remove enforcement.
    if ! parent_exists; then
        die "cannot read the configuration for $IFACE; refusing to change its firewall attachments"
        return 1
    fi

    # Defence in depth: reject a bridged attachment even if the per-leaf
    # commit validation was bypassed (for example a configuration loaded by an
    # older package).
    local any_desired=0
    for family in name ipv6-name; do
        for dir in in out local; do
            if node_exists_working firewall "$dir" "$family"; then
                any_desired=1
            fi
        done
    done
    if [ "$any_desired" -eq 1 ] && node_exists_working bridge-group bridge; then
        die "firewall attachments are not supported on VXLAN bridge port $IFACE"
        return 1
    fi

    if ! desired=$(desired_state); then
        return 1
    fi
    validate_state <<<"$desired" || return 1

    while IFS= read -r line; do old_lines+=("$line"); done <<<"$old_state"
    while IFS= read -r line; do desired_lines+=("$line"); done <<<"$desired"

    for i in "${!old_lines[@]}"; do
        read -r old_family old_dir old_target <<<"${old_lines[$i]}"
        read -r _ _ new_target <<<"${desired_lines[$i]}"
        if [ "$old_target" = "$new_target" ]; then
            continue
        fi
        changes=$((changes + 1))
        if [ "$old_target" = "-" ] && [ "$new_target" != "-" ]; then
            new_attachment=1
        fi
        if [ "$old_target" != "-" ] && [ "$new_target" = "-" ]; then
            removal=1
        fi
    done

    if [ "$changes" -eq 0 ]; then
        return 0
    fi

    # Quiesce when the change set cannot be reduced to a single atomic vendor
    # operation:
    #   * a removal reduces enforcement while the interface is operational;
    #   * more than one dispatch change applies sequentially, so the interface
    #     could otherwise carry an intermediate combination that neither the
    #     previous nor the final configuration intended.
    # A single replacement or insertion remains unquiesced: it is one atomic
    # iptables table commit and does not reduce enforcement.
    QUIESCED=0
    if [ "$removal" -eq 1 ] || [ "$changes" -gt 1 ]; then
        read_admin_state
        case "$IFACE_ADMIN" in
            up | unknown)
                if ! sudo ip link set dev "$IFACE" down; then
                    die "cannot quiesce $IFACE before changing its firewall dispatch"
                    return 1
                fi
                read_admin_state
                if [ "$IFACE_ADMIN" != "down" ]; then
                    die "cannot confirm that $IFACE is down; refusing to change its firewall dispatch"
                    return 1
                fi
                QUIESCED=1
                ;;
        esac
    fi

    APPLY_NEW_ATTACHMENT=$new_attachment
    MUTATED=1

    for i in "${!old_lines[@]}"; do
        read -r old_family old_dir old_target <<<"${old_lines[$i]}"
        read -r _ _ new_target <<<"${desired_lines[$i]}"
        if [ "$old_target" = "$new_target" ]; then
            continue
        fi
        case "$old_family" in v4) FAMILY=name ;; v6) FAMILY=ipv6-name ;; esac
        DIRECTION=$old_dir
        if [ "$new_target" = "-" ]; then
            if ! "$UBNT_FW" update-interface delete "$IFACE" "$DIRECTION" "$old_target" "$FAMILY"; then
                echo "ERROR: native firewall engine failed to remove $FAMILY attachment from $IFACE ($old_dir)" >&2
                recover_apply_failure "$new_attachment" "$old_state"
                return 1
            fi
            if ! hits=$(find_target); then
                recover_apply_failure "$new_attachment" "$old_state"
                return 1
            fi
            case "$hits" in
                '') ;;
                *)
                    echo "ERROR: firewall attachment is still effective after removal: $IFACE $old_dir $FAMILY -> $hits" >&2
                    recover_apply_failure "$new_attachment" "$old_state"
                    return 1
                    ;;
            esac
        else
            NAME=$new_target
            if ! check_name; then
                recover_apply_failure "$new_attachment" "$old_state"
                return 1
            fi
            if ! check_native_name; then
                recover_apply_failure "$new_attachment" "$old_state"
                return 1
            fi
            if ! "$UBNT_FW" update-interface update "$IFACE" "$DIRECTION" "$new_target" "$FAMILY"; then
                echo "ERROR: native firewall engine failed to install $FAMILY attachment '$new_target' on $IFACE ($old_dir)" >&2
                recover_apply_failure "$new_attachment" "$old_state"
                return 1
            fi
            if ! verify_present; then
                recover_apply_failure "$new_attachment" "$old_state"
                return 1
            fi
        fi
    done

    if ! require_all_effective; then
        MUTATED=0
        # The desired set was applied but is not effective (missing, stale,
        # shadowed, unreachable or without a terminal default).  Restore the
        # pre-change state where possible, then stop the interface: the
        # configuration requires enforcement that the dataplane does not have.
        if ! restore_state <<<"$old_state"; then
            echo "ERROR: could not restore the pre-commit firewall state for $IFACE." >&2
            stop_interface "could not restore the pre-commit firewall state"
            return 1
        fi
        stop_interface "the configured firewall attachments are not effective"
        return 1
    fi
    MUTATED=0
    return 0
}

require_all_effective() {
    local family dir configured missing=0
    check_iface
    for family in name ipv6-name; do
        FAMILY=$family
        for dir in in out local; do
            DIRECTION=$dir
            if node_exists_working firewall "$dir" "$family"; then
                configured=$(node_value firewall "$dir" "$family") || {
                    die "cannot read configured $family attachment for $IFACE ($dir)"
                    return 1
                }
                NAME=$configured
                if ! check_name; then
                    return 1
                fi
                if ! ruleset_exists; then
                    die "firewall ruleset '$NAME' is not configured under firewall $FAMILY"
                    return 1
                fi
                if ! chain_is_nonempty; then
                    return 1
                fi
                if ! chain_has_terminal_default; then
                    return 1
                fi
                if ! verify_dispatch_exact; then
                    missing=1
                fi
                if ! verify_hook_reachable; then
                    missing=1
                fi
            fi
        done
    done
    [ "$missing" -eq 0 ] || {
        die "refusing to make $IFACE operational without its configured firewall attachments"
        return 1
    }
    return 0
}

remove_all() {
    local family dir target hits
    check_iface
    for family in name ipv6-name; do
        FAMILY=$family
        for dir in in out local; do
            DIRECTION=$dir
            if ! target=$(target_or_absent); then
                return 1
            fi
            [ "$target" = "-" ] && continue
            if ! "$UBNT_FW" update-interface delete "$IFACE" "$DIRECTION" "$target" "$FAMILY"; then
                die "cannot remove firewall dispatch $target from $IFACE ($dir, $family)"
                return 1
            fi
            if ! hits=$(find_target); then
                return 1
            fi
            if [ -n "$hits" ]; then
                die "firewall dispatch still present after removal: $IFACE $dir $family -> $hits"
                return 1
            fi
        done
    done
    return 0
}

status() {
    local family dir configured effective
    check_iface
    if ! parent_exists; then
        printf 'interface %s is not configured, or the configuration API is unavailable outside a configuration session\n' "$IFACE" >&2
        return 1
    fi
    for family in name ipv6-name; do
        for dir in in out local; do
            if node_exists_working firewall "$dir" "$family"; then
                configured=$(node_value firewall "$dir" "$family")
            else
                configured="-"
            fi
            FAMILY=$family
            DIRECTION=$dir
            effective=$(target_or_absent)
            printf 'configured %s %s %s\n' "$family" "$dir" "$configured"
            printf 'effective  %s %s %s\n' "$family" "$dir" "$effective"
        done
    done
    return 0
}

# ------------------------------------------------------------- exit recovery

# Set while the desired dispatch set is being applied.  If the script exits
# unexpectedly after a mutation (for example a configuration-API diagnostic in
# a later verification), the trap restores the pre-change state instead of
# leaving the new dispatch live.
MUTATED=0
APPLY_OLD_STATE=""
APPLY_NEW_ATTACHMENT=0
settle_on_exit() {
    local rc=$?
    [ "$MUTATED" -eq 1 ] || return 0
    MUTATED=0
    echo "ERROR: unexpected exit after a firewall change; restoring the pre-change state." >&2
    if restore_state <<<"$APPLY_OLD_STATE"; then
        if [ "$APPLY_NEW_ATTACHMENT" -eq 1 ]; then
            fail_closed_new_attachment
        elif [ "${QUIESCED:-0}" -eq 1 ]; then
            resume_interface "the pre-change firewall state was restored" || true
        fi
    else
        stop_interface "could not restore the pre-change firewall state"
    fi
    return "$rc"
}
trap settle_on_exit EXIT

# ------------------------------------------------------------------- main

mode=${1:-}
case "$mode" in
    --validate)
        shift
        [ $# -eq 4 ] || { usage; exit 2; }
        IFACE=$1 DIRECTION=$2 FAMILY=$3 NAME=$4
        validate_attachment
        ;;
    --capture)
        [ $# -eq 2 ] || { usage; exit 2; }
        IFACE=$2
        check_iface
        capture_state
        ;;
    --apply)
        [ $# -eq 2 ] || { usage; exit 2; }
        IFACE=$2
        check_iface
        apply_state
        ;;
    --restore)
        [ $# -eq 2 ] || { usage; exit 2; }
        IFACE=$2
        check_iface
        restore_state
        ;;
    --verify-all)
        [ $# -eq 2 ] || { usage; exit 2; }
        IFACE=$2
        require_all_effective
        ;;
    --remove-all)
        [ $# -eq 2 ] || { usage; exit 2; }
        IFACE=$2
        remove_all
        ;;
    --status)
        [ $# -eq 2 ] || { usage; exit 2; }
        IFACE=$2
        status
        ;;
    *)
        usage
        exit 2
        ;;
esac
