#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
#
# vyatta-vxlan - EdgeOS reconciliation helper for VXLAN interfaces.
# Dual-family (IPv4/IPv6) underlay, fail-closed live-state snapshots and
# transactional recreation with rollback.  Paths that tests need to replace
# are overridable via environment variables (defaults unchanged).

set -eEu -o pipefail

if [ "$(id -g -n)" != "vyattacfg" ]; then
    echo "This script must be executed from vyatta configuration system."
    exit 1
fi

ACTION=${1:?missing commit action}
INTERFACE=${2:?missing interface}

VYATTA_SBINDIR=${vyatta_sbindir:-/opt/vyatta/sbin}
VYATTA_API="${VYATTA_SBINDIR}/my_cli_shell_api"
VXLAN_ADDR="${VYATTA_SBINDIR}/vyatta-vxlan-addr"
VXLAN_BIN_BRCTL=${vxlan_bin_brctl:-/usr/sbin/brctl}
VXLAN_BIN_MODPROBE=${vxlan_bin_modprobe:-/sbin/modprobe}
VXLAN_SYSFS_ROOT=${vxlan_sysfs_root:-/sys}

node_exists() {
    "$VYATTA_API" exists interfaces vxlan "$INTERFACE" "$@"
}

node_value() {
    "$VYATTA_API" returnValue interfaces vxlan "$INTERFACE" "$@"
}

node_values() {
    "$VYATTA_API" returnValues interfaces vxlan "$INTERFACE" "$@"
}

interface_exists() {
    ip link show dev "$INTERFACE" >/dev/null 2>&1
}

# Administrative-state bitmask of $INTERFACE as a decimal number.  The kernel
# prints this sysfs attribute as 0x-prefixed hexadecimal (net-sysfs fmt_hex
# with the %#x format); bare decimal is accepted too for other sources.
# Anything else is rejected before any arithmetic is attempted.
read_iface_flags() {
    local raw digits
    if ! raw=$(cat "${VXLAN_SYSFS_ROOT}/class/net/$INTERFACE/flags" 2>/dev/null); then
        echo "ERROR: cannot read administrative state of $INTERFACE." >&2
        return 1
    fi
    case "$raw" in
        0[xX]*)
            digits=${raw#0[xX]}
            case "$digits" in
                '' | *[!0-9a-fA-F]*)
                    echo "ERROR: unexpected administrative state '$raw'." >&2
                    return 1
                    ;;
            esac
            printf '%d\n' "$((0x$digits))"
            ;;
        '' | *[!0-9]*)
            echo "ERROR: unexpected administrative state '$raw'." >&2
            return 1
            ;;
        *)
            printf '%d\n' "$((10#$raw))"
            ;;
    esac
}

# Canonical endpoint text; an unspecified local address is represented as "-"
# so it compares equal to a live interface that has no `local`/`local6` key.
canon_endpoint() {
    local c
    c=$("$VXLAN_ADDR" canon "$1") || return 1
    case "$c" in
        0.0.0.0 | ::) printf '%s' "-" ;;
        *) printf '%s' "$c" ;;
    esac
}

# Canonical text for addr/prefix values (literal part canonicalised, prefix
# kept verbatim) so non-canonical spellings compare equal (ADJ-1).
canon_prefixed() {
    local ap=${1%%/*} prefix=${1#*/} c
    [ "$ap" != "$1" ] || return 1
    c=$("$VXLAN_ADDR" canon "$ap") || return 1
    printf '%s/%s\n' "$c" "$prefix"
}

get_live_bridge() {
    local link
    if [ ! -L "${VXLAN_SYSFS_ROOT}/class/net/${INTERFACE}/brport/bridge" ]; then
        return 0
    fi
    link=$(readlink "${VXLAN_SYSFS_ROOT}/class/net/${INTERFACE}/brport/bridge") || return 0
    basename "$link"
}

get_live_bridge_cost() {
    cat "${VXLAN_SYSFS_ROOT}/class/net/${INTERFACE}/brport/path_cost"
}

get_live_bridge_priority() {
    cat "${VXLAN_SYSFS_ROOT}/class/net/${INTERFACE}/brport/priority"
}

apply_live_bridge_port_options() {
    local bridge=$1 cost=$2 priority=$3
    sudo "$VXLAN_BIN_BRCTL" setpathcost "$bridge" "$INTERFACE" "$cost" || return $?
    sudo "$VXLAN_BIN_BRCTL" setportprio "$bridge" "$INTERFACE" "$priority" || return $?
}

reconcile_bridge() {
    local desired_bridge=$1 current_bridge rc
    current_bridge=$(get_live_bridge)

    if [ "$current_bridge" = "$desired_bridge" ]; then
        return 0
    fi

    if [ -n "$desired_bridge" ] &&
        [ ! -d "${VXLAN_SYSFS_ROOT}/class/net/${desired_bridge}/bridge" ]; then
        echo "ERROR: Bridge $desired_bridge does not exist." >&2
        return 1
    fi

    if [ -n "$current_bridge" ]; then
        sudo "$VXLAN_BIN_BRCTL" delif "$current_bridge" "$INTERFACE" || return $?
    fi

    if [ -n "$desired_bridge" ]; then
        sudo "$VXLAN_BIN_BRCTL" addif "$desired_bridge" "$INTERFACE" || {
            rc=$?
            echo "ERROR: Failed to add $INTERFACE to $desired_bridge." >&2
            if [ -n "$current_bridge" ] &&
                [ -d "${VXLAN_SYSFS_ROOT}/class/net/${current_bridge}/bridge" ]; then
                echo "Restoring $INTERFACE to $current_bridge..." >&2
                sudo "$VXLAN_BIN_BRCTL" addif "$current_bridge" "$INTERFACE" || {
                    echo "ERROR: Failed to restore bridge membership." >&2
                    return 2
                }
            fi
            return "$rc"
        }
    fi
    return 0
}

delete_interface() {
    if interface_exists; then
        sudo ip link set dev "$INTERFACE" down || true
        sudo ip link del dev "$INTERFACE"
    fi
}

create_vxlan() {
    local interface=$1 vni=$2 local_ip=$3 remote_ip=$4 port=$5 family
    if [ "$local_ip" = "-" ]; then
        family=$("$VXLAN_ADDR" family "$remote_ip") || return 1
        if [ "$family" = "v6" ]; then
            local_ip="::"
        else
            local_ip="0.0.0.0"
        fi
    fi
    sudo ip link add dev "$interface" type vxlan \
        id "$vni" \
        local "$local_ip" \
        remote "$remote_ip" \
        dstport "$port"
}

contains_address() {
    local needle=$1 address
    shift
    for address in "$@"; do
        if [ "$address" = "$needle" ]; then
            return 0
        fi
    done
    return 1
}

derive_mac() {
    local base_mac hash first
    base_mac=$(cat "${VXLAN_SYSFS_ROOT}/class/net/eth0/address")

    hash=$(
        printf '%s' "${base_mac}:${INTERFACE}" |
            sha256sum |
            awk '{print $1}'
    )

    # Force locally-administered + unicast: bit 1 = 1, bit 0 = 0.
    first=$(((0x${hash:0:2} & 0xfc) | 0x02))

    printf '%02x:%s:%s:%s:%s:%s\n' \
        "$first" \
        "${hash:2:2}" \
        "${hash:4:2}" \
        "${hash:6:2}" \
        "${hash:8:2}" \
        "${hash:10:2}"
}

# kind <TAB> id <TAB> port <TAB> family <TAB> local <TAB> remote
get_live_vxlan_identity() {
    ip -j -d link show dev "$INTERFACE" | "$VXLAN_ADDR" parse-live
}

read_desired_addresses() {
    local raw c out i
    DESIRED_ADDRESSES=()
    if node_exists address; then
        if ! raw=$(node_values address); then
            echo "ERROR: cannot read configured addresses for $INTERFACE." >&2
            return 1
        fi
        eval "DESIRED_ADDRESSES=( $raw )"
        out=()
        for i in "${DESIRED_ADDRESSES[@]}"; do
            if ! c=$(canon_prefixed "$i"); then
                echo "ERROR: cannot normalise configured address '$i'." >&2
                return 1
            fi
            out+=("$c")
        done
        DESIRED_ADDRESSES=("${out[@]}")
    fi
    return 0
}

read_live_addresses() {
    local out c line
    LIVE_ADDRESSES=()
    if ! out=$(ip -o addr show dev "$INTERFACE" scope global); then
        echo "ERROR: cannot read live addresses of $INTERFACE." >&2
        return 1
    fi
    while read -r line; do
        case "$line" in
            *" inet "* | *" inet6 "*) ;;
            *) continue ;;
        esac
        c=$(printf '%s\n' "$line" | awk '{print $4}')
        [ -n "$c" ] || continue
        if ! c=$(canon_prefixed "$c"); then
            echo "ERROR: cannot normalise live address '$c'." >&2
            return 1
        fi
        LIVE_ADDRESSES+=("$c")
    done <<<"$out"
    return 0
}

apply_desired_mutable_state() {
    local live_mtu live_description flags address
    live_mtu=$(cat "${VXLAN_SYSFS_ROOT}/class/net/$INTERFACE/mtu")

    if [ "$live_mtu" != "$MTU" ]; then
        sudo ip link set dev "$INTERFACE" mtu "$MTU" || return $?
    fi

    live_description=$(cat "${VXLAN_SYSFS_ROOT}/class/net/$INTERFACE/ifalias" 2>/dev/null || true)
    if [ "$live_description" != "$DESCRIPTION" ]; then
        sudo ip link set dev "$INTERFACE" alias "$DESCRIPTION" || return $?
    fi

    read_desired_addresses || return $?
    read_live_addresses || return $?

    # Detach from a bridge before configuring L3 addresses.
    if [ -z "$BRIDGE" ]; then
        "${VYATTA_SBINDIR}/vyatta-vxlan-bridge" "$INTERFACE" || return $?
    fi

    for address in "${LIVE_ADDRESSES[@]}"; do
        if ! contains_address "$address" "${DESIRED_ADDRESSES[@]}"; then
            sudo "${VYATTA_SBINDIR}/vyatta-address" delete "$INTERFACE" "$address" || return $?
        fi
    done

    for address in "${DESIRED_ADDRESSES[@]}"; do
        if ! contains_address "$address" "${LIVE_ADDRESSES[@]}"; then
            sudo "${VYATTA_SBINDIR}/vyatta-address" add "$INTERFACE" "$address" || return $?
        fi
    done

    # When transitioning to L2 operation, remove addresses first and only
    # then reconcile the complete requested bridge-port state.
    if [ -n "$BRIDGE" ]; then
        "${VYATTA_SBINDIR}/vyatta-vxlan-bridge" "$INTERFACE" || return $?
    fi

    if ! flags=$(read_iface_flags); then
        return 1
    fi

    if node_exists disable; then
        if (((flags & 0x1) != 0)); then
            sudo ip link set dev "$INTERFACE" down || return $?
        fi
    else
        if (((flags & 0x1) == 0)); then
            sudo ip link set dev "$INTERFACE" up || return $?
        fi
    fi

    return 0
}

# Every component read is status-checked: an incomplete snapshot must abort
# the commit before anything is deleted (RB-2).
capture_live_snapshot() {
    local identity flags
    OLD_ADDRESSES=()

    if ! identity=$(get_live_vxlan_identity); then
        echo "ERROR: cannot read live VXLAN identity for $INTERFACE." >&2
        return 1
    fi

    IFS=$'\t' read -r OLD_KIND OLD_VNI OLD_PORT OLD_FAMILY OLD_LOCAL_IP OLD_REMOTE_IP <<<"$identity"

    if [ "$OLD_KIND" != "vxlan" ]; then
        echo "ERROR: $INTERFACE exists but is not a VXLAN interface." >&2
        return 1
    fi
    case "$OLD_VNI" in '' | *[!0-9]*)
        echo "ERROR: incomplete live identity (VNI)." >&2
        return 1
        ;;
    esac
    case "$OLD_PORT" in '' | *[!0-9]*)
        echo "ERROR: incomplete live identity (UDP port)." >&2
        return 1
        ;;
    esac
    case "$OLD_FAMILY" in v4 | v6) ;;
    *)
        echo "ERROR: incomplete live identity (address family)." >&2
        return 1
        ;;
    esac
    if [ -z "$OLD_LOCAL_IP" ] || [ -z "$OLD_REMOTE_IP" ]; then
        echo "ERROR: incomplete live identity (endpoints)." >&2
        return 1
    fi

    if ! OLD_MAC=$(cat "${VXLAN_SYSFS_ROOT}/class/net/$INTERFACE/address" 2>/dev/null); then
        echo "ERROR: cannot read live MAC address." >&2
        return 1
    fi
    if ! [[ "$OLD_MAC" =~ ^([0-9a-f]{2}:){5}[0-9a-f]{2}$ ]]; then
        echo "ERROR: unexpected live MAC address '$OLD_MAC'." >&2
        return 1
    fi

    if ! OLD_MTU=$(cat "${VXLAN_SYSFS_ROOT}/class/net/$INTERFACE/mtu" 2>/dev/null); then
        echo "ERROR: cannot read live MTU." >&2
        return 1
    fi
    case "$OLD_MTU" in '' | *[!0-9]*)
        echo "ERROR: unexpected live MTU '$OLD_MTU'." >&2
        return 1
        ;;
    esac

    if ! OLD_DESCRIPTION=$(cat "${VXLAN_SYSFS_ROOT}/class/net/$INTERFACE/ifalias" 2>/dev/null); then
        echo "ERROR: cannot read live description." >&2
        return 1
    fi

    OLD_BRIDGE=$(get_live_bridge)
    OLD_BRIDGE_COST=""
    OLD_BRIDGE_PRIORITY=""
    if [ -n "$OLD_BRIDGE" ]; then
        if ! OLD_BRIDGE_COST=$(get_live_bridge_cost) ||
            ! OLD_BRIDGE_PRIORITY=$(get_live_bridge_priority); then
            echo "ERROR: cannot read live bridge port state." >&2
            return 1
        fi
    fi

    if ! flags=$(read_iface_flags); then
        return 1
    fi
    if (((flags & 0x1) != 0)); then
        OLD_UP=1
    else
        OLD_UP=0
    fi

    if ! read_live_addresses; then
        return 1
    fi
    OLD_ADDRESSES=("${LIVE_ADDRESSES[@]}")

    return 0
}

rollback_live_snapshot() {
    local address
    echo "Rolling back $INTERFACE to previous live state..." >&2

    if interface_exists; then
        sudo ip link set dev "$INTERFACE" down || true
        sudo ip link del dev "$INTERFACE" || return 1
    fi

    create_vxlan \
        "$INTERFACE" \
        "$OLD_VNI" \
        "$OLD_LOCAL_IP" \
        "$OLD_REMOTE_IP" \
        "$OLD_PORT" || return 1

    sudo ip link set dev "$INTERFACE" address "$OLD_MAC" || return 1
    sudo ip link set dev "$INTERFACE" mtu "$OLD_MTU" || return 1
    sudo ip link set dev "$INTERFACE" alias "$OLD_DESCRIPTION" || return 1

    for address in "${OLD_ADDRESSES[@]}"; do
        sudo "${VYATTA_SBINDIR}/vyatta-address" add "$INTERFACE" "$address" || return 1
    done

    reconcile_bridge "$OLD_BRIDGE" || return 1

    if [ -n "$OLD_BRIDGE" ]; then
        apply_live_bridge_port_options \
            "$OLD_BRIDGE" \
            "$OLD_BRIDGE_COST" \
            "$OLD_BRIDGE_PRIORITY" || return 1
    fi

    if [ "$OLD_UP" -eq 1 ]; then
        sudo ip link set dev "$INTERFACE" up || return 1
    fi

    echo "Rollback of $INTERFACE completed." >&2
    return 0
}

if [ "$ACTION" = "DELETE" ]; then
    delete_interface
    exit 0
fi

VNI=$(node_value vni)
LOCAL_IP=$(node_value local-ip)
REMOTE_IP=$(node_value remote-ip)

if node_exists port; then
    PORT=$(node_value port)
else
    PORT=4789
fi

# Defence in depth: validate the desired endpoints before any mutation, even
# though the configuration templates validate them as well (RB-7).
if ! REMOTE_FAMILY=$("$VXLAN_ADDR" family "$REMOTE_IP"); then
    echo "ERROR: remote-ip '$REMOTE_IP' is not a valid IPv4 or IPv6 address." >&2
    exit 1
fi
if ! LOCAL_CANON=$(canon_endpoint "$LOCAL_IP") ||
    ! REMOTE_CANON=$(canon_endpoint "$REMOTE_IP"); then
    echo "ERROR: cannot normalise configured underlay endpoints." >&2
    exit 1
fi
"$VXLAN_ADDR" check-endpoints "$LOCAL_IP" "$REMOTE_IP" || exit 1

if node_exists mtu; then
    MTU=$(node_value mtu)
else
    MTU=$("$VXLAN_ADDR" default-mtu "$REMOTE_FAMILY")
fi

if node_exists description; then
    DESCRIPTION=$(node_value description)
else
    DESCRIPTION=""
fi

if node_exists bridge-group bridge; then
    BRIDGE=$(node_value bridge-group bridge)
else
    BRIDGE=""
fi

read_desired_addresses || exit 1

if [ -n "$BRIDGE" ] &&
    [ "${#DESIRED_ADDRESSES[@]}" -ne 0 ]; then
    echo "ERROR: Can not add interface $INTERFACE with addresses to bridge." >&2
    exit 1
fi

MAC=$(derive_mac)

"$VXLAN_BIN_MODPROBE" udp_tunnel
"$VXLAN_BIN_MODPROBE" ip6_udp_tunnel
"$VXLAN_BIN_MODPROBE" vxlan

RECREATE=0
HAVE_OLD_SNAPSHOT=0

if interface_exists; then
    if ! capture_live_snapshot; then
        echo "ERROR: refusing to modify $INTERFACE: live state could not be captured completely." >&2
        exit 1
    fi
    HAVE_OLD_SNAPSHOT=1

    if [ "$OLD_VNI" != "$VNI" ] ||
        [ "$OLD_PORT" != "$PORT" ] ||
        [ "$OLD_FAMILY" != "$REMOTE_FAMILY" ] ||
        [ "$OLD_LOCAL_IP" != "$LOCAL_CANON" ] ||
        [ "$OLD_REMOTE_IP" != "$REMOTE_CANON" ]; then
        RECREATE=1
    fi
else
    RECREATE=1
fi

if [ "$RECREATE" -eq 1 ]; then
    delete_interface

    set +e

    create_vxlan \
        "$INTERFACE" \
        "$VNI" \
        "$LOCAL_IP" \
        "$REMOTE_IP" \
        "$PORT"

    APPLY_RC=$?

    if [ "$APPLY_RC" -eq 0 ]; then
        sudo ip link set dev "$INTERFACE" address "$MAC"
        APPLY_RC=$?
    fi

    if [ "$APPLY_RC" -eq 0 ]; then
        apply_desired_mutable_state
        APPLY_RC=$?
    fi

    set -e

    if [ "$APPLY_RC" -ne 0 ]; then
        echo "ERROR: Failed to apply requested VXLAN state for $INTERFACE." >&2

        if [ "$HAVE_OLD_SNAPSHOT" -eq 1 ]; then
            if ! rollback_live_snapshot; then
                echo "ERROR: Rollback of $INTERFACE also failed." >&2
                exit 2
            fi
        else
            delete_interface || true
        fi

        exit "$APPLY_RC"
    fi

    exit 0
fi

apply_desired_mutable_state
