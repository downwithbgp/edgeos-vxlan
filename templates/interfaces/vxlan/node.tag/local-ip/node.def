type: ipv4,ipv6
help: Local underlay address of this VTEP [REQUIRED]
val_help: ipv4; Local IPv4 address
val_help: ipv6; Local IPv6 address
syntax:expression: exec "/opt/vyatta/sbin/vyatta-vxlan-addr check-endpoint local $VAR(@)"
syntax:expression: exec "/opt/vyatta/sbin/vyatta-vxlan-addr present $VAR(@) || echo Warning! IP address $VAR(@) does not exist on this system"
