type: u32
priority: 460
help: Maximum Transmission Unit (MTU)
syntax:expression: $VAR(@) >= 68 && $VAR(@) <= 8024; "Must be between 68-8024"
val_help: u32:68-8024; Maximum Transmission Unit (MTU)

syntax:expression: exec " \
       mtu=`/usr/sbin/ubnt-hal getMtu`; \
       if [ $VAR(@) -gt $mtu ]; then \
           echo The max allowed MTU on this platform is $mtu; \
           exit 1; \
       fi"

update: if /opt/vyatta/sbin/vyatta-vxlan-addr identity-matches $VAR(../@); then sudo ip link set dev $VAR(../@) mtu $VAR(@); fi

delete: if /opt/vyatta/sbin/vyatta-vxlan-addr identity-matches $VAR(../@); then mtu=$(/opt/vyatta/sbin/vyatta-vxlan-addr default-mtu-if $VAR(../@)) && sudo ip link set dev $VAR(../@) mtu "$mtu"; fi
