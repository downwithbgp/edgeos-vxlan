#!/bin/sh
set -e

case "$1" in
    remove)
        if [ -f /config/config.boot ] &&
           grep -Eq '^[[:space:]]+vxlan[[:space:]]+vxlan[0-9]+[[:space:]]*\{' /config/config.boot; then
            echo "ERROR: Saved VXLAN configuration still exists."
            echo
            echo "Remove the VXLAN configuration and save before uninstalling:"
            echo
            echo "  configure"
            echo "  delete interfaces vxlan"
            echo "  commit"
            echo "  save"
            echo "  exit"
            echo
            echo "edgeos-vxlan has not been removed."
            exit 1
        fi

        if ! vxlan_links=$(ip link show type vxlan 2>&1); then
            echo "ERROR: Cannot determine whether live VXLAN interfaces exist."
            echo
            echo "Refusing to remove the integration without a verified check."
            echo "Run 'ip link show type vxlan' manually and remove any VXLAN"
            echo "interfaces before uninstalling."
            echo
            echo "edgeos-vxlan has not been removed."
            exit 1
        fi

        if [ -n "$vxlan_links" ]; then
            echo "ERROR: Live VXLAN interfaces still exist."
            echo
            echo "Remove or disable all VXLAN interfaces before uninstalling:"
            echo
            echo "  configure"
            echo "  delete interfaces vxlan"
            echo "  commit"
            echo "  save"
            echo "  exit"
            echo
            echo "edgeos-vxlan has not been removed."
            exit 1
        fi
        ;;
esac

exit 0
