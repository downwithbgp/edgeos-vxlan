#!/bin/sh
set -e

KERNEL="4.14.54-UBNT"
TARGET="/lib/modules/$KERNEL/kernel/net/ipv4/udp_tunnel.ko"
DIVERT="/lib/modules/$KERNEL/kernel/net/ipv4/udp_tunnel.ko.edgeos-vxlan-stock"
EXPECTED_SHA256="14fbf8c469a7c902ce53d79de581e3e14982a9d52dbc80515d5ab481afb0fa94"

case "$1" in
    install|upgrade)
        VERSION="$(cat /etc/version 2>/dev/null || true)"

        case "$VERSION" in
            EdgeRouter.ER-e50.v3.0.1.5862409.*)
                ;;
            *)
                echo "ERROR: Unsupported EdgeOS firmware."
                echo "Detected: ${VERSION:-unknown}"
                echo
                echo "This package has been validated only on:"
                echo "  EdgeRouter ER-e50"
                echo "  EdgeOS v3.0.1 build 5862409"
                exit 1
                ;;
        esac

        if [ "$(uname -r)" != "$KERNEL" ]; then
            echo "ERROR: Unsupported running kernel."
            echo "Detected: $(uname -r)"
            echo "Required: $KERNEL"
            exit 1
        fi

        DIVERSION="$(dpkg-divert --list "$TARGET" 2>/dev/null || true)"

        if [ -n "$DIVERSION" ]; then
            echo "$DIVERSION" | grep -Fq "by edgeos-vxlan-kmod" || {
                echo "ERROR: $TARGET is already diverted by another package:"
                echo "$DIVERSION"
                exit 1
            }

            if [ ! -f "$DIVERT" ]; then
                echo "ERROR: Diverted stock udp_tunnel module is missing:"
                echo "  $DIVERT"
                exit 1
            fi

            ACTUAL_SHA256="$(sha256sum "$DIVERT" | awk '{print $1}')"
        else
            if [ ! -f "$TARGET" ]; then
                echo "ERROR: Missing stock EdgeOS module:"
                echo "  $TARGET"
                exit 1
            fi

            ACTUAL_SHA256="$(sha256sum "$TARGET" | awk '{print $1}')"

            if [ "$ACTUAL_SHA256" != "$EXPECTED_SHA256" ]; then
                echo "ERROR: Unsupported or locally modified stock udp_tunnel.ko."
                echo "Expected: $EXPECTED_SHA256"
                echo "Actual:   $ACTUAL_SHA256"
                echo "File:     $TARGET"
                exit 1
            fi

            dpkg-divert \
                --package edgeos-vxlan-kmod \
                --add \
                --rename \
                --divert "$DIVERT" \
                "$TARGET"
        fi

        if [ "$ACTUAL_SHA256" != "$EXPECTED_SHA256" ]; then
            echo "ERROR: Unsupported diverted stock udp_tunnel.ko."
            echo "Expected: $EXPECTED_SHA256"
            echo "Actual:   $ACTUAL_SHA256"
            echo "File:     $DIVERT"
            exit 1
        fi
        ;;
esac

exit 0
