{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgeos-vxlan.dev/release-candidate/v1",
  "title": "edgeos-vxlan release candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidate",
    "project",
    "source",
    "buildEnvironment",
    "build",
    "artifacts",
    "qualification",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "https://edgeos-vxlan.dev/release-candidate/v1"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "createdAt",
        "status",
        "nonRelease"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/candidateId"
        },
        "createdAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "status": {
          "enum": [
            "built",
            "qualified",
            "rejected"
          ]
        },
        "nonRelease": {
          "type": "boolean"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "repository",
        "repositoryId",
        "releaseTag",
        "packageVersion",
        "sourceDateEpoch",
        "releasePolicySha256"
      ],
      "properties": {
        "name": {
          "const": "edgeos-vxlan"
        },
        "repository": {
          "const": "downwithbgp/edgeos-vxlan"
        },
        "repositoryId": {
          "type": "integer",
          "minimum": 1
        },
        "releaseTag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "packageVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(\\+edgeos[0-9.]+\\.[a-z0-9]+)?$"
        },
        "sourceDateEpoch": {
          "type": "integer",
          "minimum": 0
        },
        "releasePolicySha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "archiveSha256",
        "packagingInputsSha256",
        "trustedWorkflow"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "archiveSha256": {
          "$ref": "#/$defs/sha256"
        },
        "packagingInputsSha256": {
          "$ref": "#/$defs/sha256"
        },
        "trustedWorkflow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "path",
            "ref",
            "commit"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "$ref": "#/$defs/gitCommit"
            }
          }
        }
      }
    },
    "buildEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "ociIndexDigest",
        "manifestDigest",
        "configDigest",
        "ociArchiveSha256",
        "dockerArchiveSha256",
        "dockerfileSha256",
        "caBundleSha256",
        "dependencySnapshot",
        "dependencyInventorySha256",
        "qualificationSha256",
        "imageSbomSha256"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "ociIndexDigest": {
          "$ref": "#/$defs/digest"
        },
        "manifestDigest": {
          "$ref": "#/$defs/digest"
        },
        "configDigest": {
          "$ref": "#/$defs/digest"
        },
        "ociArchiveSha256": {
          "$ref": "#/$defs/sha256"
        },
        "dockerArchiveSha256": {
          "$ref": "#/$defs/sha256"
        },
        "dockerfileSha256": {
          "$ref": "#/$defs/sha256"
        },
        "caBundleSha256": {
          "$ref": "#/$defs/sha256"
        },
        "dependencySnapshot": {
          "type": "string",
          "minLength": 1
        },
        "dependencyInventorySha256": {
          "$ref": "#/$defs/sha256"
        },
        "qualificationSha256": {
          "$ref": "#/$defs/sha256"
        },
        "imageSbomSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildType",
        "command",
        "reproducibility",
        "identity"
      ],
      "properties": {
        "buildType": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "reproducibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "comparedArtifacts"
          ],
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not-performed"
              ]
            },
            "comparedArtifacts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "identity": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "size",
          "sha256",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "role": {
            "enum": [
              "package",
              "debian-metadata",
              "sbom",
              "environment-qualification"
            ]
          }
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checks",
        "hardware",
        "ipv6"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "evidenceSha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "not-performed"
                ]
              },
              "evidenceSha256": {
                "$ref": "#/$defs/sha256"
              },
              "evidenceFile": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "required",
            "evidence"
          ],
          "properties": {
            "status": {
              "enum": [
                "not-required",
                "not-qualified",
                "qualified"
              ]
            },
            "required": {
              "type": "boolean"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "ipv6": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "level",
            "buildIdentity",
            "sourceCommit",
            "package",
            "packageSha256",
            "reconcilerSha256",
            "workflow",
            "harness",
            "evidence",
            "capture",
            "reconciler",
            "skips",
            "workarounds"
          ],
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not-performed"
              ]
            },
            "level": {
              "const": "B"
            },
            "buildIdentity": {
              "$ref": "#/$defs/sha256"
            },
            "sourceCommit": {
              "$ref": "#/$defs/gitCommit"
            },
            "package": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
            },
            "packageSha256": {
              "$ref": "#/$defs/sha256"
            },
            "reconcilerSha256": {
              "$ref": "#/$defs/sha256"
            },
            "addrHelperSha256": {
              "$ref": "#/$defs/sha256"
            },
            "workflow": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "runId",
                "runAttempt",
                "repository",
                "path",
                "ref",
                "commit"
              ],
              "properties": {
                "runId": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "runAttempt": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "repository": {
                  "const": "downwithbgp/edgeos-vxlan"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "commit": {
                  "$ref": "#/$defs/gitCommit"
                }
              }
            },
            "harness": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "commit",
                "version"
              ],
              "properties": {
                "path": {
                  "const": "test/ipv6-only-netns.sh"
                },
                "commit": {
                  "$ref": "#/$defs/gitCommit"
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dir",
                "summarySha256"
              ],
              "properties": {
                "dir": {
                  "const": "qualification/ipv6-only"
                },
                "summarySha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            },
            "capture": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "underlaySha256",
                "overlaySha256",
                "analysisSha256"
              ],
              "properties": {
                "status": {
                  "const": "executed"
                },
                "underlaySha256": {
                  "$ref": "#/$defs/sha256"
                },
                "overlaySha256": {
                  "$ref": "#/$defs/sha256"
                },
                "analysisSha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            },
            "reconciler": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "evidenceSha256"
              ],
              "properties": {
                "status": {
                  "const": "executed"
                },
                "evidenceSha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            },
            "skips": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "workarounds": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "applied"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "applied": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
