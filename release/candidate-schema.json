{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgeos-vxlan.dev/release-candidate/v1",
  "title": "edgeos-vxlan release candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidate",
    "project",
    "source",
    "buildEnvironment",
    "build",
    "artifacts",
    "qualification",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "https://edgeos-vxlan.dev/release-candidate/v1"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "createdAt", "status", "nonRelease"],
      "properties": {
        "id": { "$ref": "#/$defs/candidateId" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "enum": ["built", "qualified", "rejected"] },
        "nonRelease": { "type": "boolean" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "repository",
        "repositoryId",
        "releaseTag",
        "packageVersion",
        "sourceDateEpoch",
        "releasePolicySha256"
      ],
      "properties": {
        "name": { "const": "edgeos-vxlan" },
        "repository": { "const": "downwithbgp/edgeos-vxlan" },
        "repositoryId": { "type": "integer", "minimum": 1 },
        "releaseTag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "packageVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(\\+edgeos[0-9.]+\\.[a-z0-9]+)?$"
        },
        "sourceDateEpoch": { "type": "integer", "minimum": 0 },
        "releasePolicySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "archiveSha256",
        "packagingInputsSha256",
        "trustedWorkflow"
      ],
      "properties": {
        "commit": { "$ref": "#/$defs/gitCommit" },
        "archiveSha256": { "$ref": "#/$defs/sha256" },
        "packagingInputsSha256": { "$ref": "#/$defs/sha256" },
        "trustedWorkflow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "path", "ref", "commit"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 },
            "ref": { "type": "string", "minLength": 1 },
            "commit": { "$ref": "#/$defs/gitCommit" }
          }
        }
      }
    },
    "buildEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "ociIndexDigest",
        "manifestDigest",
        "configDigest",
        "ociArchiveSha256",
        "dockerArchiveSha256",
        "dockerfileSha256",
        "caBundleSha256",
        "dependencySnapshot",
        "dependencyInventorySha256",
        "qualificationSha256",
        "imageSbomSha256"
      ],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "ociIndexDigest": { "$ref": "#/$defs/digest" },
        "manifestDigest": { "$ref": "#/$defs/digest" },
        "configDigest": { "$ref": "#/$defs/digest" },
        "ociArchiveSha256": { "$ref": "#/$defs/sha256" },
        "dockerArchiveSha256": { "$ref": "#/$defs/sha256" },
        "dockerfileSha256": { "$ref": "#/$defs/sha256" },
        "caBundleSha256": { "$ref": "#/$defs/sha256" },
        "dependencySnapshot": { "type": "string", "minLength": 1 },
        "dependencyInventorySha256": { "$ref": "#/$defs/sha256" },
        "qualificationSha256": { "$ref": "#/$defs/sha256" },
        "imageSbomSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildType", "command", "reproducibility"],
      "properties": {
        "buildType": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "reproducibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "comparedArtifacts"],
          "properties": {
            "status": { "enum": ["passed", "failed", "not-performed"] },
            "comparedArtifacts": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "size", "sha256", "role"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
          },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "role": {
            "enum": [
              "package",
              "debian-metadata",
              "sbom",
              "environment-qualification"
            ]
          }
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks", "hardware"],
      "properties": {
        "status": { "enum": ["pending", "passed", "failed"] },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "evidenceSha256"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "status": { "enum": ["passed", "failed", "not-performed"] },
              "evidenceSha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "required", "evidence"],
          "properties": {
            "status": {
              "enum": ["not-required", "not-qualified", "qualified"]
            },
            "required": { "type": "boolean" },
            "evidence": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "candidateId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
